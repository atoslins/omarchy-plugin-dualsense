#!/usr/bin/env bash
# Print one version's notes from CHANGELOG.md — the body of its GitHub release
# and of its annotated tag.
set -euo pipefail

version=${1:?usage: scripts/release-notes X.Y.Z}
cd "$(dirname "$0")/.."

notes=$(awk -v heading="## [$version]" '
  index($0, heading) == 1 { on = 1; next }
  on && /^## \[/ { exit }
  on { print }
' CHANGELOG.md | sed -e '/./,$!d')

[[ -n $notes ]] || { echo "release-notes: CHANGELOG.md has no notes for $version" >&2; exit 1; }
printf '%s\n' "$notes"
