#!/usr/bin/env bash
# Cut a release: date the CHANGELOG's Unreleased notes as X.Y.Z, bump
# manifest.json, run the tests, commit "Release X.Y.Z" and tag vX.Y.Z.
# Nothing is pushed: pushing main is what ships it (see CONTRIBUTING.md).
set -euo pipefail

fail() {
  echo "release: $*" >&2
  exit 1
}

version=${1:-}
[[ $version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || fail "usage: scripts/release X.Y.Z"
cd "$(dirname "$0")/.."

[[ -z $(git status --porcelain) ]] || fail "commit or stash your changes first"
! git rev-parse -q --verify "refs/tags/v$version" >/dev/null || fail "tag v$version already exists"
current=$(jq -r .version manifest.json)
[[ $current != "$version" && $(printf '%s\n' "$current" "$version" | sort -V | tail -n 1) == "$version" ]] ||
  fail "$version is not newer than $current"
unreleased=$(awk '/^## \[Unreleased\]/ { on = 1; next } /^## \[/ { on = 0 } on' CHANGELOG.md)
[[ -n ${unreleased//[[:space:]]/} ]] || fail "nothing under ## [Unreleased] in CHANGELOG.md"

# Write through the existing files so they keep their mode.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
jq --arg v "$version" '.version = $v' manifest.json >"$tmp"
cat "$tmp" >manifest.json
sed -i "s/^## \[Unreleased\]\$/## [Unreleased]\n\n## [$version] — $(date +%F)/" CHANGELOG.md

if ! python3 -m unittest discover -s tests -q; then
  git checkout -- manifest.json CHANGELOG.md
  fail "tests failed; nothing was committed"
fi

git add manifest.json CHANGELOG.md
git commit -q -m "Release $version"
{
  echo "DualSense $version"
  echo
  scripts/release-notes "$version"
} | git tag -a --cleanup=whitespace -F - "v$version"

echo "Tagged v$version on $(git rev-parse --short HEAD). Ship it with:"
echo "  git push --atomic origin HEAD:main v$version"
