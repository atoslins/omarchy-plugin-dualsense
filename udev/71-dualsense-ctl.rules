# Give the active seat user read/write access to the DualSense hidraw node so
# dualsense-ctl (and the Omarchy DualSense plugin) can set the lightbar, LEDs,
# triggers and audio without root. Not needed when the steam-devices package
# is installed — it ships the same rules.
#
# Install with the verifier that ships next to this file — it checks the SHA-256
# of these bytes before and after copying them as root, so nothing but the
# reviewed rule can land in /etc/udev/rules.d:
#
#   sudo ./install-udev-rule
#
# then reconnect the controller. `./install-udev-rule check` reports the state,
# `sudo ./install-udev-rule remove` takes it out again.

# DualSense over USB / Bluetooth
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
# DualSense Edge over USB / Bluetooth
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"

# Motion sensor and touchpad input nodes — only the gamepad node gets uaccess
# by default. These let the plugin's live tester show gyro/accel and touches.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="*054C:0CE6*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="*054C:0DF2*", TAG+="uaccess"
